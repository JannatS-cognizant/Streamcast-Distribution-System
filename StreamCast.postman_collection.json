{
  "info": {
    "name": "StreamCast — Full Microservices API",
    "description": "Complete API collection for the StreamCast microservices, routed through the API-Gateway at http://localhost:8082.\n\nServices covered:\n- Identity-Auth-Service (auth, users, roles)\n- Content-Catalog-Service (titles, assets, metadata)\n- Contract-Service (contracts)\n- Clause-Service (clauses)\n- Partner-Service (partners)\n- Distribution-Delivery (manifests, attempts, receipts)\n- schedule-service (schedules, conflicts)\n- usage-service (usage analytics)\n\nThe `Auth / Login` request automatically saves the JWT to the `{{authToken}}` collection variable. Every protected request uses Bearer-token auth at the collection level — no per-request setup needed.\n\nDefault credentials variables (`adminEmail` / `adminPassword`) and sample IDs are pre-set in the collection variables — edit them to match your data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "streamcast-full-collection-2026"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{authToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082", "type": "string" },
    { "key": "authToken", "value": "", "type": "string" },
    { "key": "adminEmail", "value": "admin@streamcast.com", "type": "string" },
    { "key": "adminPassword", "value": "admin123", "type": "string" },
    { "key": "registerEmail", "value": "newuser@streamcast.com", "type": "string" },
    { "key": "registerPassword", "value": "pass123", "type": "string" },
    { "key": "roleId", "value": "1", "type": "string" },
    { "key": "userId", "value": "1", "type": "string" },
    { "key": "titleId", "value": "1", "type": "string" },
    { "key": "assetId", "value": "1", "type": "string" },
    { "key": "metadataId", "value": "1", "type": "string" },
    { "key": "contractId", "value": "1", "type": "string" },
    { "key": "clauseId", "value": "1", "type": "string" },
    { "key": "partnerId", "value": "1", "type": "string" },
    { "key": "manifestId", "value": "1", "type": "string" },
    { "key": "scheduleId", "value": "1", "type": "string" },
    { "key": "conflictId", "value": "1", "type": "string" },
    { "key": "verifyToken", "value": "PASTE_FROM_SERVICE_LOG", "type": "string" },
    { "key": "resetToken", "value": "PASTE_FROM_SERVICE_LOG", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level pre-request — nothing required, but a hook is here if needed."
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth (Identity-Auth-Service)",
      "description": "Public auth endpoints: register / login / verify-email / forgot-password / reset-password / forgot-username. Login auto-saves the JWT.",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\",\n  \"roleId\": {{roleId}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login (saves authToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body && body.token) {",
                  "        pm.collectionVariables.set('authToken', body.token);",
                  "        console.log('authToken saved:', body.token.slice(0, 20) + '...');",
                  "    }",
                  "    pm.test('login returns token + user', () => {",
                  "        pm.expect(body).to.have.property('token');",
                  "        pm.expect(body).to.have.property('user');",
                  "    });",
                  "} else {",
                  "    console.warn('Login failed:', pm.response.code, pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/verify?token={{verifyToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify"],
              "query": [{ "key": "token", "value": "{{verifyToken}}" }]
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password?email={{adminEmail}}",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password"],
              "query": [{ "key": "email", "value": "{{adminEmail}}" }]
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password?token={{resetToken}}&newPassword=newPass123",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password"],
              "query": [
                { "key": "token", "value": "{{resetToken}}" },
                { "key": "newPassword", "value": "newPass123" }
              ]
            }
          }
        },
        {
          "name": "Forgot Username",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-username?email={{adminEmail}}",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-username"],
              "query": [{ "key": "email", "value": "{{adminEmail}}" }]
            }
          }
        }
      ]
    },
